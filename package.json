{
  "name": "@cinderblock/mlx90363",
  "version": "0.0.0",
  "description": "Node.js API for manipulating and parsing MLX90363 magnetic-rotary sensor data packets",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/MLX90363.d.ts",
      "default": "./dist/MLX90363.js"
    }
  },
  "files": [
    "dist/",
    "src/",
    "!dist/**/*.test.*",
    "!src/**/*.test.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cinderblock/node-MLX90363.git"
  },
  "homepage": "https://github.com/cinderblock/node-MLX90363#readme",
  "bugs": {
    "url": "https://github.com/cinderblock/node-MLX90363/issues"
  },
  "keywords": [
    "mlx90363",
    "melexis",
    "magnetic",
    "rotary",
    "sensor",
    "spi"
  ],
  "author": "Cameron Tacklind <cameron@tacklind.com> (https://cameron.tacklind.com)",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "prepare": "test -d dist || npm run build",
    "test": "npm run build && node --test dist/MLX90363.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "^22.19.20",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  }
}
